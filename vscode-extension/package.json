{
  "name": "svg-editor-vscode",
  "displayName": "SVG Editor",
  "description": "在 Explorer 中标记 SVG 文件，并在原生 Outline 中展示 SVG 结构。",
  "version": "0.1.0",
  "publisher": "svg-editor-lab",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test out/test/unit/*.test.js && node out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.7.2"
  }
}
