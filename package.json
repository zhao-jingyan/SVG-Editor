{
  "name": "svg-editor",
  "version": "1.0.0",
  "description": "SVG editor CLI",
  "main": "dist/main.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && resolve-tspaths -p tsconfig.json -s src -o dist && node scripts/copy-plugin-manifests.mjs",
    "start": "node dist/main.js",
    "cli": "node dist/main.js",
    "lint": "node scripts/lint-layer-boundaries.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run tests/e2e",
    "e2e": "node scripts/e2e.mjs",
    "metrics": "node scripts/generate-metrics.mjs",
    "verify:dual-assembly": "node scripts/verify-dual-assembly.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "resolve-tspaths": "^0.8.23",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.7"
  }
}
